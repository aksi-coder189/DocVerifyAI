# Optional runtime settings (export these variables before starting the API)
DOCVERIFY_DATA_DIR=./data
DOCVERIFY_MAX_UPLOAD_MB=15

# 0 disables automatic cleanup. Set a positive value only when retention is intended.
DOCVERIFY_RETENTION_DAYS=0
# Optional shared bearer token for local API access; set matching VITE_DOCVERIFY_API_TOKEN in frontend/.env.local
# DOCVERIFY_API_TOKEN=replace-with-a-long-random-local-secret
# For frontend/.env.local only; use the same value as DOCVERIFY_API_TOKEN (local-only guard).
# VITE_DOCVERIFY_API_TOKEN=replace-with-a-long-random-local-secret
